{
  "name": "mp-asset-management-tests",
  "private": true,
  "type": "module",
  "description": "Security-rules, emulator and UI workflow tests for the MP Developers Asset Management app",
  "scripts": {
    "test:unit": "node --test --test-reporter=spec unit/calc.test.mjs",
    "test:mock": "node --test --test-reporter=spec mock-e2e/e2e-mock.test.mjs",
    "test:rules": "firebase --config ../firebase.json emulators:exec --project demo-mp-assets --only firestore \"node --test --test-reporter=spec rules/rules.test.mjs\"",
    "test:emulator-e2e": "firebase --config ../firebase.json emulators:exec --project demo-mp-assets --only auth,firestore \"node --test --test-reporter=spec emulator-e2e/app-emulator.test.mjs\"",
    "test": "npm run test:unit && npm run test:mock && npm run test:rules && npm run test:emulator-e2e"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "exceljs": "4.4.0",
    "firebase": "12.19.0",
    "firebase-tools": "15.34.0",
    "playwright": "1.64.1"
  }
}
